# Copy to .env.local and fill in. All of these are PUBLIC (NEXT_PUBLIC_*) and safe
# to ship to the browser: authorization is enforced by RLS in the database, never
# by the client. No service-role key or Razorpay secret belongs in this file.

# ── Portfolio Supabase project (the one-pager + its CMS) ─────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<portfolio-project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<portfolio anon key>

# Optional: raises the GitHub stats rate limit from 60 to 5000 req/hour (server-only).
GITHUB_TOKEN=

# ── Courses Supabase project (a SEPARATE project — see backend/courses/) ─────
# Run backend/courses/supabase/*.sql in that project, then deploy the edge
# functions in backend/courses/supabase/functions/.
NEXT_PUBLIC_COURSES_SUPABASE_URL=https://<courses-project>.supabase.co
NEXT_PUBLIC_COURSES_SUPABASE_ANON_KEY=<courses anon key>

# Gated edge function URLs (Dashboard → Edge Functions → details → URL).
NEXT_PUBLIC_COURSES_CREATE_ORDER_URL=https://<courses-project>.supabase.co/functions/v1/create-order
NEXT_PUBLIC_COURSES_GET_PDF_URL_URL=https://<courses-project>.supabase.co/functions/v1/get-pdf-url
NEXT_PUBLIC_COURSES_LESSON_SECRET_URL=https://<courses-project>.supabase.co/functions/v1/get-lesson-secret
NEXT_PUBLIC_COURSES_GET_VIDEO_URL=https://<courses-project>.supabase.co/functions/v1/get-video
NEXT_PUBLIC_COURSES_GET_LIVE_LINK_URL=https://<courses-project>.supabase.co/functions/v1/get-live-link
NEXT_PUBLIC_COURSES_GET_HLS_URL=https://<courses-project>.supabase.co/functions/v1/get-hls-url
NEXT_PUBLIC_COURSES_GET_EXERCISE_URL=https://<courses-project>.supabase.co/functions/v1/get-exercise

# Razorpay PUBLISHABLE key (test mode is free). The secret lives only in the
# edge function secrets — never here.
NEXT_PUBLIC_COURSES_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# Public site URL used for Razorpay callback/redirect (e.g. https://your-site.com).
NEXT_PUBLIC_COURSES_SITE_URL=http://localhost:3000

# ── PrepMeUp AI (College Learning Platform) ──────────────────────────────────
# Supabase PrepMeUp AI
NEXT_PUBLIC_PMU_SUPABASE_URL=https://<prepmeup-project>.supabase.co
NEXT_PUBLIC_PMU_SUPABASE_ANON_KEY=<prepmeup-anon-key>
PMU_SUPABASE_SERVICE_ROLE_KEY=<prepmeup-service-role-key>

# Twilio Verify / WhatsApp OTP
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_CHANNEL=whatsapp

# App
PMU_APP_URL=http://localhost:3000
PMU_OTP_DEV_MODE=false

# ── Self-Hosted CMS (Directus + Cloudflare Tunnel) ──────────────────────────
CMS_API_URL=https://cms.yourdomain.com
CMS_API_TOKEN=your-service-token
CMS_WEBHOOK_SECRET=your-webhook-secret
NEXT_PUBLIC_CMS_URL=https://cms.yourdomain.com/admin

# ── Phase Q2: Quantum AI, Mentorship & Certificates ──────────────────────────
# Quantum AI
GEMINI_API_KEY=
GEMINI_QUANTUM_MODEL=gemini-2.5-flash

# Certificate PDF
CERTIFICATE_SIGNING_SECRET=
CERTIFICATE_STORAGE_BUCKET=pmu-certificates

# Mentorship
GOOGLE_MEET_BASE_URL=
MENTORSHIP_DEFAULT_TIMEZONE=Asia/Kolkata

# ── Phase Q3: Razorpay Quantum & Pricing ──────────────────────────────────────
# Razorpay Quantum
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_WEBHOOK_SECRET=

# Quantum pricing
QUANTUM_SEMESTER_PASS_PRICE_IN_PAISE=99900
QUANTUM_MENTORSHIP_PACK_PRICE_IN_PAISE=49900
QUANTUM_EARLY_ADOPTER_LIMIT=10

# ── Phase C3: Unified PrepMeUp Checkout ──────────────────────────────────────
# Dedicated Razorpay credentials for the unified checkout + its own webhook.
# Never commit real secrets; the secret key and webhook secret are server-only.
UNIFIED_RAZORPAY_KEY_ID=
UNIFIED_RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_UNIFIED_RAZORPAY_KEY_ID=
UNIFIED_RAZORPAY_WEBHOOK_SECRET=

# Pricing (server-authoritative; the browser only ever receives the computed amount)
BTech_SEMESTER_PASS_PRICE_IN_PAISE=9900
QUANTUM_SEMESTER_PASS_PRICE_IN_PAISE=99900
CYBER_SECURITY_SEMESTER_PASS_PRICE_IN_PAISE=99900
ALL_ACCESS_SEMESTER_PASS_PRICE_IN_PAISE=149900
QUANTUM_MENTORSHIP_PACK_PRICE_IN_PAISE=49900
CYBER_SECURITY_MENTORSHIP_PACK_PRICE_IN_PAISE=49900
ALL_ACCESS_MENTORSHIP_PACK_PRICE_IN_PAISE=89900
ALL_ACCESS_EARLY_ADOPTER_LIMIT=10
