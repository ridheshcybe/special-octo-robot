[Template]
# PrepMeUp AI — Hostinger Node.js Web App (.env)
# Copy to `.env`, strip `<...>` placeholders, and fill in the real values.
#
# SECURITY RULES:
#  - Never commit a real `.env`. Keep this file out of git: add `/deploy_hostinger.sh`
#    and `/package_for_hostinger.py` to .gitignore (already present), then `cp .env.example .env`.
#  - NEXT_PUBLIC_* keys are the only ones the browser may read. Service-role, webhook,
#    Razorpay secret, Twilio, and Upstash keys stay server-only.
#  - Next.js 16 requires Node.js 20 LTS+; do not use `output: 'export'`.
#  - Hostinger injects `$PORT`; the app reads it automatically and has no hardcoded port.

# ── Portfolio / Courses (shared Next.js server + edge functions) ──────────────
NEXT_PUBLIC_SUPABASE_URL=https://<YOUR_PORTFOLIO_PROJECT>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<YOUR_PORTFOLIO_ANON_KEY>
GITHUB_TOKEN=<github-token-optional>

NEXT_PUBLIC_COURSES_SUPABASE_URL=https://<YOUR_COURSES_PROJECT>.supabase.co
NEXT_PUBLIC_COURSES_SUPABASE_ANON_KEY=<YOUR_COURSES_ANON_KEY>
NEXT_PUBLIC_COURSES_CREATE_ORDER_URL=https://<YOUR_COURSES_PROJECT>.supabase.co/functions/v1/create-order
NEXT_PUBLIC_COURSES_GET_PDF_URL_URL=https://<YOUR_COURSES_PROJECT>.supabase.co/functions/v1/get-pdf-url
NEXT_PUBLIC_COURSES_LESSON_SECRET_URL=https://<YOUR_COURSES_PROJECT>.supabase.co/functions/v1/get-lesson-secret
NEXT_PUBLIC_COURSES_GET_VIDEO_URL=https://<YOUR_COURSES_PROJECT>.supabase.co/functions/v1/get-video
NEXT_PUBLIC_COURSES_GET_LIVE_LINK_URL=https://<YOUR_COURSES_PROJECT>.supabase.co/functions/v1/get-live-link
NEXT_PUBLIC_COURSES_GET_HLS_URL=https://<YOUR_COURSES_PROJECT>.supabase.co/functions/v1/get-hls-url
NEXT_PUBLIC_COURSES_GET_EXERCISE_URL=https://<YOUR_COURSES_PROJECT>.supabase.co/functions/v1/get-exercise
NEXT_PUBLIC_COURSES_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
NEXT_PUBLIC_COURSES_SITE_URL=https://<YOUR_PORTFOLIO_URL>
NEXT_PUBLIC_COURSES_NEWSLETTER_API_URL=https://<YOUR_COURSES_PROJECT>.supabase.co/functions/v1/newsletter
NEXT_PUBLIC_COURSES_PORTFOLIO_URL=https://<YOUR_PORTFOLIO_URL>

# ── PrepMeUp AI (supabase-universal) ──────────────────────────────────────────
NEXT_PUBLIC_PMU_SUPABASE_URL=https://<YOUR_PMU_PROJECT>.supabase.co
NEXT_PUBLIC_PMU_SUPABASE_ANON_KEY=<YOUR_PMU_ANON_KEY>
PMU_SUPABASE_SERVICE_ROLE_KEY=<YOUR_PMU_SERVICE_ROLE_KEY>
PMU_SUPABASE_URL=https://<YOUR_PMU_PROJECT>.supabase.co

# ── Channels ──────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=<HOSTINGER_EMAIL_USER>
SMTP_PASS=<HOSTINGER_EMAIL_PASS>
RESEND_API_KEY=<resend-api-key-or-empty>

# ── App / Sessions ────────────────────────────────────────────────────────────
PMU_APP_URL=https://<YOUR_HOSTINGER_DOMAIN>
PMU_OTP_DEV_MODE=false
PMU_SESSION_SECRET=<min-32-chars-prod-secret>
PMU_ENABLE_DEV_ADMIN_FALLBACK=false

# ── AI / Gemini ───────────────────────────────────────────────────────────────
GEMINI_API_KEY=<GEMINI_API_KEY>
GEMINI_TEXT_MODEL=gemini-1.5-flash
GEMINI_DOCUMENT_MODEL=gemini-1.5-flash
GROQ_API_KEY=<GROQ_API_KEY-optional>

# ── Payments / Razorpay ───────────────────────────────────────────────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=<RAZORPAY_KEY_SECRET>
RAZORPAY_WEBHOOK_SECRET=<RAZORPAY_WEBHOOK_SECRET>
UNIFIED_RAZORPAY_KEY_SECRET=<UNIFIED_RAZORPAY_KEY_SECRET>
UNIFIED_RAZORPAY_WEBHOOK_SECRET=<UNIFIED_RAZORPAY_WEBHOOK_SECRET>
NEXT_PUBLIC_UNIFIED_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx

# ── Twilio (WhatsApp OTP) ─────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_CHANNEL=whatsapp

# ── Rate limiting / Redis (optional; DB fallback is used if unset) ────────────
UPSTASH_REDIS_REST_URL=<UPSTASH_REDIS_REST_URL>
UPSTASH_REDIS_REST_TOKEN=<UPSTASH_REDIS_REST_TOKEN>

# ── Certificates / Mentorship ──────────────────────────────────────────────────
CERTIFICATE_SIGNING_SECRET=<cert-signing-secret>
CERTIFICATE_STORAGE_BUCKET=pmu-certificates

GOOGLE_MEET_BASE_URL=https://meet.google.com
MENTORSHIP_DEFAULT_TIMEZONE=Asia/Kolkata

# ── Self-Hosted CMS (optional) ────────────────────────────────────────────────
CMS_API_URL=https://<YOUR_CMS_DOMAIN>
CMS_API_TOKEN=<cms-service-token>
CMS_WEBHOOK_SECRET=<cms-webhook-secret>
NEXT_PUBLIC_CMS_URL=https://<YOUR_CMS_DOMAIN>/admin

# ── Phase Q3 production pricing — values are server-authoritative, never shipped ─
BTech_SEMESTER_PASS_PRICE_IN_PAISE=9900
QUANTUM_SEMESTER_PASS_PRICE_IN_PAISE=99900
CYBER_SECURITY_SEMESTER_PASS_PRICE_IN_PAISE=99900
ALL_ACCESS_SEMESTER_PASS_PRICE_IN_PAISE=149900
QUANTUM_MENTORSHIP_PACK_PRICE_IN_PAISE=49900
CYBER_SECURITY_MENTORSHIP_PACK_PRICE_IN_PAISE=49900
ALL_ACCESS_MENTORSHIP_PACK_PRICE_IN_PAISE=89900
ALL_ACCESS_EARLY_ADOPTER_LIMIT=10
